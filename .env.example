# DATABASE
# ------------------------------------------------------------------------------
# PostgreSQL connection string for Prisma.
# Replace with your actual local or hosted PostgreSQL credentials.
DATABASE_URL="postgresql://postgres:password@localhost:5432/press_contacts?schema=public"

# NEXTAUTH (Authentication Settings)
# ------------------------------------------------------------------------------
# A random secret key used to encrypt the NextAuth.js JWT tokens.
# You can generate a strong secret via CLI: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-random-key-at-least-32-chars-long"

# NextAuth canonical URL (Localhost for development)
NEXTAUTH_URL="http://localhost:3000"

# OAUTH PROVIDERS
# ------------------------------------------------------------------------------
# Google OAuth configuration for social login
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# FILE STORAGE / CLOUD SERVICES (Optional Roadmap)
# ------------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID="your-aws-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret"
# AWS_S3_BUCKET_NAME="press-contacts-assets"
